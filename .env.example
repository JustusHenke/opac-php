# Admin-Secret für Bestandsimport-Aktionen (mimport.php).
# Diese Vorlage ist die .env.example; die echte .env ist gitignored und per
# Root-.htaccess vor Web-Zugriff geschützt.
#
# Secret generieren z. B. mit:
#   openssl rand -hex 24
# oder
#   php -r "echo bin2hex(random_bytes(24));"
#
# Anleitung: cp .env.example .env   -> dann Wert eintragen.
OPAC_ADMIN_SECRET=

# Obergrenze (Bytes) für den automatischen Bestandsabgleich beim Seitenaufruf.
# Größere .bib-Dateien werden nicht mehr automatisch importiert, sondern nur als
# "Import ausstehend" markiert (Import dann über mimport.php oder
# `php import_bibtex.php`). 0 = niemals automatisch, Default: 8388608 (8 MB).
#OPAC_AUTO_SYNC_MAX_BYTES=8388608
